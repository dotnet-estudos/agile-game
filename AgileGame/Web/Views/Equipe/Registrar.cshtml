@model Domain.Entidade.Equipe

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Equipe</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.EquipeId)


        <div class="col-sm-4">
            <div class="card  text-white mb-4 bg-primary">
                <div class="card-header">Escolha Sua Equipe e Registre o Nome do Seu time</div>
                <div class="card-body bg-light text-dark">
                    Hash:
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Hash, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Hash, "", new { @class = "text-danger" })
                    </div>
                    <p class="card-text text-dark">
                        Nome:
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Nome, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Nome, "", new { @class = "text-danger" })
                        </div>


                    </p>
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </div>
    </div>
}
