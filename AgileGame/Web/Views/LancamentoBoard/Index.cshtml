@model IEnumerable<Domain.Entidade.LancamentoBoard>

@{
    ViewBag.Title = "Lancamento Board";
}

<h2>@ViewBag.Title</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Equipe.Hash)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Fase.Nome)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Jogo.NomeTurma)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DiaLancamento)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Quantidade)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Equipe.Hash)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Fase.Nome)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Jogo.NomeTurma)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DiaLancamento)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Quantidade)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.LancamentoBoardId }) |
            @Html.ActionLink("Details", "Details", new { id=item.LancamentoBoardId }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.LancamentoBoardId })
        </td>
    </tr>
}

</table>
