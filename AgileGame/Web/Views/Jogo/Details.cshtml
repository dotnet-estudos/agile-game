@model Domain.Entidade.Jogo

@{
    ViewBag.Title = "Details";

}

<h2>Details</h2>

<div>
    <h4>Jogo</h4>
    <hr/>
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Board.Nome)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Board.Nome)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.NomeTurma)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.NomeTurma)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.QuantidadeEquipes)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.QuantidadeEquipes)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.DataCadastro)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.DataCadastro)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Finalizado)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Finalizado)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.DataHoraFim)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.DataHoraFim)
        </dd>

    </dl>
</div>

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.NomeTurma)
        </th>
        <th>
            @Html.DisplayName("Hash")
        </th>
        <th>
            @Html.DisplayName("Nome")
        </th>
        <th>
            @Html.DisplayName("Lead Time")
        </th>
        <th>
            @Html.DisplayName("Esforco Kaizen")
        </th>
        <th>
            @Html.DisplayName("Ranking")
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model.Equipes.ToList().OrderByDescending(x=>x.GetRankValue()))
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Jogo.NomeTurma)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Hash)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @item.GetLeadTime()
            </td>
            <td>
                @item.GetEsforcoKaizen()
            </td>
            <td>
               <i title="@item.GetRankValuePercent().ToString("##.##")%">@item.GetRankValue().ToString("##.###")</i> 
            </td>
            <td>
                @Html.ActionLink("Board", "_LancamentoBoard", new { id = item.EquipeId }, htmlAttributes: new { @class="btn btn-primary"})  |
                @*<input type="button" class="btn btn-primary" name="name" value="Board" onclick=" ShowLancamentoBoard(@item.EquipeId); "/>*@
                @*@Html.ActionLink("Edit", "Edit", "Equipe", new {id = item.EquipeId}) |
                @Html.ActionLink("Details", "Details", "Equipe", new {id = item.EquipeId}) |*@

            </td>
            @*<div data-mostra="false" id="BackLog_@item.EquipeId">
                @Html.Partial("_LancamentoBoard", item.LancamentoBoard)
            </div>*@
        </tr>
    }

</table>



<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.JogoId }) |
    @Html.ActionLink("Back to List", "Index")
</p>


<script>
    $(document).ready(function() {
        $("div[data-mostra=false]").hide();

        comprasnet.showModal("Lancamento Board", true, "Olha eu Aew");
    });

    function ShowLancamentoBoard(id) {
        $.get("@Url.Action("_LancamentoBoard")/"+id, function(response) {
            if (response) {
                comprasnet.showModal("Board", false, response);
            } else {
                comprasnet.alertAtencao("Não foi possivel carregar board: " + response);
            }
        })
    }
</script>