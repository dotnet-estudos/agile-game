@using System.Runtime.InteropServices
@model Domain.Entidade.Jogo

<div>
    <h4>Jogo Da Turma: @Model.NomeTurma</h4>
    <hr />
    <h4>use a Url: @Url.Action("Registrar", "Equipe") Para Registar Sua Equipe </h4>
    <hr />
    @*<h4>Use o Hash para Registar a Turma: @Model.Hash</h4>
        <hr/>
        <h4>@Url.Action("Registrar","Equipe", Model.Hash)  </h4>*@
</div>

@{
    <div class="card-deck">
        @foreach (var equipe in Model.Equipes)
        {
            <div class="col-md-4 col-sm-1">
                @Html.Partial("_Equipe", equipe)
            </div>

        }
    </div>
}

<div class="">
    <img src='https://chart.googleapis.com/chart?chs=400x400&cht=qr&chl=@string.Format("{0}{1}",Request.Url.ToString().Replace(Request.Url.AbsolutePath.ToString(),"") ,Url.Action("Registrar", "Equipe"))'>
</div>

