@model IEnumerable<Domain.Entidade.Jogo>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Board.Nome)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.NomeTurma)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.QuantidadeEquipes)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DataCadastro)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Finalizado)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DataHoraFim)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Board.Nome)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.NomeTurma)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.QuantidadeEquipes)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DataCadastro)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Finalizado)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DataHoraFim)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.JogoId }) |
            @Html.ActionLink("Details", "Details", new { id=item.JogoId }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.JogoId })
        </td>
    </tr>
}

</table>
