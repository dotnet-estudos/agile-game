<h1 class="h1"> Board da Equipe: @Model.First().Equipe.Nome (@Model.First().Equipe.Hash) </h1>

<table class="table-bordered table-responsive table-hover table-striped">
    <thead>
        <tr>
            <td>Dia</td>
            @foreach (var item in listFase)
            {

                <td style="background-color: @item.RGB">@item.Nome</td>

            }
        </tr>

    </thead>
    <tbody>
        @foreach (var itemGrp in dataGroup)
        {
            <tr>
                <td class="text-center">@itemGrp.Key.Dia</td>
                @foreach (var qtd in itemGrp.Dia)
                {
                    <td class="text-center"> @qtd.Quantidade</td>
                }
            </tr>
        }
    </tbody>
</table>

<br/>
<div id="CFD"></div>

@Html.ActionLink("Back to List", "Details", new { id = Model.First().JogoId })



<script>
    $(document).ready(function () {

        var divDados = "CFD";
        var _time = "@Model.First().Equipe.Nome";

        loadCfd();

        function loadCfd() {

            var data = new Object();
            data.time = "@Model.First().Equipe.Hash";
            data.jogo = "@Model.First().JogoId";//(new Date).getFullYear() + '-01-01';
        

            $.ajax({
                dataType: "json",
                url: "@Url.Action("", "api/LancamentoBoard")",
                data: data,
                complete: function () {
                    //$("#_LoadingCFD").hide();
                },
                success: function (datas) {
                    if (datas != null) {                      
                        renderComulativeFlow(divDados, 'CFD', 'Source: agilegame.local', datas.dias, " Chamado", ' Chamado(s)', datas.serie);
                    }
                }

            });
        }
    });

</script>