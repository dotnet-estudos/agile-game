@using Domain.Util
@model System.Collections.Generic.List<Domain.Entidade.LancamentoBoard>

@{
    var listFase = (List<Fase>)ViewBag.Fases;

    var data1 = Model.Select(x => new
    {
        Dia = x.DiaLancamento,
        Fase = x.Fase.Nome,
        Quantidade = x.Quantidade

    });

    var dataGroup = from d in data1
                    group d by new { d.Dia }
                    into grp
                    select new
                    {
                        grp.Key,
                        Dia = grp.Select(d2 => new { d2.Quantidade, d2.Fase, d2.Dia }).ToArray()
                    };





