@model Domain.Entidade.Fase

<div class="card text-light" style="background-color: @Model.RGB; text-shadow: 1px 1px #696969;">
    <div class="card-header d-none d-sm-block "> @Model.Nome</div>
    <div class="card-header d-block d-sm-none ">@Model.NomeAbreviado </div>
    <div class="card-body">
        <h5 class="d-none d-sm-block">Quantidade: </h5>
        <h5 class="d-block d-sm-none">Qtd: </h5>
        <p class="card-text  ">
            <input type="number" class="form-control col-md col-sm" />
        </p>
    </div>
</div>